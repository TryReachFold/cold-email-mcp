        "anne-marie-obrien@example.com",
        "a.obrien@example.com",
        "an.obrien@example.com",
        "anne-marieo@example.com",
        "anne-marie.o@example.com",
        "obrien.anne-marie@example.com",
        "oanne-marie@example.com"
      ]
    },
    {
      "name": "single_letters_dedupe",
      "first": "A",
      "last": "B",
      "domain": "",
      "expected": [
        "a",
        "b",
        "a.b",
        "ab",
        "a_b",
