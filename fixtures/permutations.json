{
  "description": "Expected email permutations, derived from the web tool at tryreachfold.com/tools/email-permutation-generator: lowercase + Cyrillic transliteration, keep [a-z -], 12 patterns in order, duplicate local parts dropped, domain cleaned of scheme/@/path.",
  "cases": [
    {
      "name": "latin_with_domain",
      "first": "Jane",
      "last": "Doe",
      "domain": "acme.com",
      "expected": [
        "jane@acme.com",
        "doe@acme.com",
        "jane.doe@acme.com",
        "janedoe@acme.com",
        "jane_doe@acme.com",
        "jane-doe@acme.com",
        "j.doe@acme.com",
        "ja.doe@acme.com",
        "janed@acme.com",
        "jane.d@acme.com",
        "doe.jane@acme.com",
        "djane@acme.com"
      ]
    },
    {
      "name": "cyrillic_no_domain",
      "first": "Иван",
      "last": "Пётр",
      "domain": "",
      "expected": [
        "ivan",
        "petr",
        "ivan.petr",
        "ivanpetr",
        "ivan_petr",
        "ivan-petr",
        "i.petr",
        "iv.petr",
        "ivanp",
        "ivan.p",
        "petr.ivan",
        "pivan"
      ]
    },
    {
      "name": "cleaned_name_and_domain",
      "first": "  Anne-Marie ",
      "last": "O'Brien",
      "domain": "https://Example.com/careers",
